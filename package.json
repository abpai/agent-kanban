{
  "name": "@andypai/agent-kanban",
  "version": "1.0.0",
  "description": "Agent-friendly kanban board CLI. Manage tasks via bash commands, parse structured JSON output.",
  "homepage": "https://github.com/abpai/agent-kanban#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abpai/agent-kanban.git"
  },
  "bugs": {
    "url": "https://github.com/abpai/agent-kanban/issues"
  },
  "keywords": [
    "agent",
    "kanban",
    "cli",
    "bun",
    "sqlite",
    "linear",
    "automation"
  ],
  "bin": {
    "kanban": "src/index.ts"
  },
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./providers/types": "./src/providers/types.ts",
    "./provider-runtime": "./src/provider-runtime.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "ui/dist"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bootstrap": "bun install && cd ui && bun install",
    "smoke": "bun src/index.ts --help",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build ./src/index.ts --target bun --outdir ./dist",
    "link": "bun link",
    "lint": "bun run lint:oxlint && bun run lint:format",
    "format": "bun x --bun --no-install prettier --write .",
    "typecheck": "bun x --bun --no-install tsc --noEmit",
    "ui:typecheck": "cd ui && bun x --bun --no-install tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run ui:typecheck",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "knip": "knip",
    "test:pg": "DATABASE_URL=${DATABASE_URL:-postgres://postgres:postgres@localhost:${KANBAN_PG_PORT:-5432}/kanban_test} bun test",
    "pg:up": "docker compose -f docker-compose.postgres.yml up -d --wait",
    "pg:down": "docker compose -f docker-compose.postgres.yml down -v",
    "seed:test": "bun --env-file=.env.test scripts/seed-test-db.ts",
    "serve": "bun src/index.ts serve",
    "ui:dev": "cd ui && bun run dev",
    "ui:build": "cd ui && bun run build",
    "dev:ui": "bun scripts/dev.ts",
    "build:ui": "bun run ui:build",
    "prepare": "if [ \"${HUSKY:-1}\" != \"0\" ] && command -v husky >/dev/null 2>&1; then husky install; fi",
    "prepack": "cd ui && bun install --frozen-lockfile && bun run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "lint:oxlint": "bun x --bun --no-install oxlint .",
    "lint:format": "bun x --bun --no-install prettier --check \"**/*.{js,mjs,jsx,ts,tsx}\" --cache --cache-strategy content --cache-location .cache/prettier/.prettier-cache",
    "test:ui": "bun run scripts/ui-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@oxlint/plugins": "1.82.0",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.2",
    "husky": "^8.0.3",
    "knip": "^6.24.0",
    "lint-staged": "^15.2.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright-core": "1.63.0",
    "prettier": "^3.7.4",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md,scss,yaml,yml}": [
      "prettier --write"
    ]
  }
}
